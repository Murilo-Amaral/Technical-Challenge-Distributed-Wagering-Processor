{
  "realm": "wagering",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "wagering-provider", "description": "Game provider: submits and reads its own wager transactions" },
      { "name": "wagering-operator", "description": "Back-office: wallets, ledger, reconciliation" }
    ]
  },
  "clientScopes": [
    {
      "name": "wagering-api-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "audience-wagering-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "wagering-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "realm_access.roles", "multivalued": "true", "access.token.claim": "true" }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "provider-a",
      "name": "Game provider A (machine-to-machine)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["wagering-api-audience"],
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-a", "jsonType.label": "String", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Game provider B (machine-to-machine)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["wagering-api-audience"],
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-b", "jsonType.label": "String", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "backoffice",
      "name": "Back-office operator (machine-to-machine)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["wagering-api-audience"]
    }
  ],
  "users": [
    { "username": "service-account-provider-a", "enabled": true, "serviceAccountClientId": "provider-a", "realmRoles": ["wagering-provider"] },
    { "username": "service-account-provider-b", "enabled": true, "serviceAccountClientId": "provider-b", "realmRoles": ["wagering-provider"] },
    { "username": "service-account-backoffice", "enabled": true, "serviceAccountClientId": "backoffice", "realmRoles": ["wagering-operator"] }
  ]
}
