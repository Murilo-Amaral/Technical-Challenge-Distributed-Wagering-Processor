# Copy to .env for local runs outside Docker. No secrets are required for local development.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_SIZE=10
DB_LOCK_TIMEOUT_MS=5000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_CREATE_QUEUES=true
WAGER_QUEUE_NAME=wager-transactions.fifo
WAGER_DLQ_NAME=wager-transactions-dlq.fifo
EVENTS_QUEUE_NAME=wagering-events.fifo
# Which background components this process runs (comma separated): consumer,outbox,pending-references
WORKERS=consumer,outbox,pending-references
# keycloak | disabled
AUTH_MODE=disabled
OIDC_ISSUER_URL=http://localhost:8080/realms/wagering
OIDC_AUDIENCE=wagering-api
