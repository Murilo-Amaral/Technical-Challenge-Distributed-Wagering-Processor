{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "test/**", "scripts/**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" },
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useImportType": "off", "noNonNullAssertion": "off", "useNodejsImportProtocol": "error" },
      "suspicious": { "noExplicitAny": "error" },
      "complexity": { "noStaticOnlyClass": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
